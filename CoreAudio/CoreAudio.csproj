<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>CoreAudio</RootNamespace>
    <AssemblyName>CoreAudio</AssemblyName>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!--
      Native miniaudio binaries are NOT checked in yet. The CI step that produces this
      project's nupkg / publish output needs to drop libminiaudio.dylib into
      runtimes/osx-arm64/native/ and runtimes/osx-x64/native/. See the upgrade plan,
      Tier 3, for the open question on bundling vs. building from source.
    -->
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Audio\Audio.csproj" />
    <ProjectReference Include="..\Util\Util.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="runtimes/osx-arm64/native/libminiaudio.dylib" Condition="Exists('runtimes/osx-arm64/native/libminiaudio.dylib')">
      <Pack>true</Pack>
      <PackagePath>runtimes/osx-arm64/native</PackagePath>
      <Link>runtimes/osx-arm64/native/libminiaudio.dylib</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="runtimes/osx-x64/native/libminiaudio.dylib" Condition="Exists('runtimes/osx-x64/native/libminiaudio.dylib')">
      <Pack>true</Pack>
      <PackagePath>runtimes/osx-x64/native</PackagePath>
      <Link>runtimes/osx-x64/native/libminiaudio.dylib</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!--
      Also drop the dylib next to the managed assembly so that a plain
      `dotnet run` from a developer machine (no publish step, no RID) still
      finds it via the default macOS dyld search path.  When the app is
      published the RID-specific copy under runtimes/ takes precedence.
    -->
    <Content Include="runtimes/osx-arm64/native/libminiaudio.dylib" Condition="Exists('runtimes/osx-arm64/native/libminiaudio.dylib') AND $([MSBuild]::IsOSPlatform('OSX')) AND '$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture)' == 'Arm64'">
      <Link>libminiaudio.dylib</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Pack>false</Pack>
    </Content>
    <Content Include="runtimes/osx-x64/native/libminiaudio.dylib" Condition="Exists('runtimes/osx-x64/native/libminiaudio.dylib') AND $([MSBuild]::IsOSPlatform('OSX')) AND '$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture)' == 'X64'">
      <Link>libminiaudio.dylib</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Pack>false</Pack>
    </Content>
  </ItemGroup>
</Project>
