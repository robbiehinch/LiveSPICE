<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:LiveSPICE.Avalonia.Services"
             x:Class="LiveSPICE.Avalonia.Controls.ComponentLibrary">
    <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="10,0,10,6">
            <TextBox x:Name="filterBox" Grid.Column="0" Watermark="Filter components..." />
            <Button Grid.Column="1" Content="✕" Margin="4,0,0,0" Click="ClearFilterClicked" ToolTip.Tip="Clear filter" />
        </Grid>
        <ScrollViewer Grid.Row="1" Padding="6,0,6,6">
            <Grid>
                <TreeView x:Name="tree">
                    <TreeView.ItemTemplate>
                        <TreeDataTemplate ItemsSource="{Binding Children}"
                                          DataType="svc:CatalogCategory">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Opacity="0.85" />
                                <ItemsControl ItemsSource="{Binding Components}" Margin="6,2,0,2">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="svc:ComponentEntry">
                                            <Button HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="6,3"
                                                    Click="ComponentClicked"
                                                    Tag="{Binding}"
                                                    IsVisible="{Binding IsVisible}"
                                                    ToolTip.Tip="{Binding Description}">
                                                <TextBlock Text="{Binding Name}" />
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </TreeDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
                <ItemsControl x:Name="filtered" IsVisible="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="svc:ComponentEntry">
                            <Button HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="6,3"
                                    Click="ComponentClicked"
                                    Tag="{Binding}"
                                    IsVisible="{Binding IsVisible}"
                                    ToolTip.Tip="{Binding Description}">
                                <TextBlock Text="{Binding Name}" />
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
