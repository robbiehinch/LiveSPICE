<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:LiveSPICE.Avalonia.Controls"
        x:Class="LiveSPICE.Avalonia.Windows.LiveSimulationWindow"
        Title="Live Simulation"
        Width="980" Height="640"
        WindowStartupLocation="CenterOwner">
    <Grid RowDefinitions="Auto,*,Auto,Auto">
        <Border Grid.Row="0" Classes="pane">
            <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,Auto,Auto,Auto,Auto" RowDefinitions="Auto,8,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Driver" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.85" />
                <ComboBox x:Name="driverCombo" Grid.Row="0" Grid.Column="1" MinWidth="160" SelectionChanged="DriverChanged" />
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Device" VerticalAlignment="Center" Margin="12,0,6,0" Opacity="0.85" />
                <ComboBox x:Name="deviceCombo" Grid.Row="0" Grid.Column="3" MinWidth="260" SelectionChanged="DeviceChanged" />
                <TextBlock Grid.Row="0" Grid.Column="4" Text="Oversample" VerticalAlignment="Center" Margin="12,0,6,0" Opacity="0.85" />
                <NumericUpDown x:Name="oversampleBox" Grid.Row="0" Grid.Column="5" Value="8" Minimum="1" Maximum="32" Width="90" />
                <TextBlock Grid.Row="0" Grid.Column="6" Text="Iterations" VerticalAlignment="Center" Margin="12,0,6,0" Opacity="0.85" />
                <NumericUpDown x:Name="iterationsBox" Grid.Row="0" Grid.Column="7" Value="8" Minimum="1" Maximum="64" Width="90" />
                <Button x:Name="startStopButton" Grid.Row="0" Grid.Column="8" Content="Start" Margin="16,0,0,0" Click="StartStopClicked" MinWidth="90" Classes="accent" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Inputs" VerticalAlignment="Top" Margin="0,4,6,0" Opacity="0.85" />
                <ListBox x:Name="inputsList" Grid.Row="2" Grid.Column="1" Height="84" SelectionMode="Multiple" />
                <TextBlock Grid.Row="2" Grid.Column="2" Text="Outputs" VerticalAlignment="Top" Margin="12,4,6,0" Opacity="0.85" />
                <ListBox x:Name="outputsList" Grid.Row="2" Grid.Column="3" Height="84" SelectionMode="Multiple" />
            </Grid>
        </Border>

        <c:ScopeView x:Name="scope" Grid.Row="1" />

        <Border Grid.Row="2" Classes="pane" Padding="14,10">
            <Grid ColumnDefinitions="Auto,*,Auto,*">
                <TextBlock Grid.Column="0" Text="In peak" VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0.85" />
                <ProgressBar x:Name="inMeter" Grid.Column="1" Minimum="0" Maximum="1" Value="0" Height="10" />
                <TextBlock Grid.Column="2" Text="Out peak" Margin="14,0,8,0" VerticalAlignment="Center" Opacity="0.85" />
                <ProgressBar x:Name="outMeter" Grid.Column="3" Minimum="0" Maximum="1" Value="0" Height="10" />
            </Grid>
        </Border>

        <Border Grid.Row="3" Classes="statusbar">
            <TextBlock x:Name="statusText" Text="Stopped." Opacity="0.85" />
        </Border>
    </Grid>
</Window>
