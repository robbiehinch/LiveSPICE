<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:LiveSPICE.Avalonia.Controls"
        x:Class="LiveSPICE.Avalonia.Windows.LiveSimulationWindow"
        Title="Live Simulation"
        Width="900" Height="600"
        Background="#1e1e1e">
    <Grid RowDefinitions="Auto,*,Auto,Auto">
        <!-- Audio config strip -->
        <Border Grid.Row="0" Background="#252526" Padding="8">
            <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,Auto,Auto,Auto,Auto" RowDefinitions="Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Driver:" Foreground="#cdcdcd" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox x:Name="driverCombo" Grid.Row="0" Grid.Column="1" MinWidth="160" SelectionChanged="DriverChanged" />
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Device:" Foreground="#cdcdcd" VerticalAlignment="Center" Margin="12,0,6,0" />
                <ComboBox x:Name="deviceCombo" Grid.Row="0" Grid.Column="3" MinWidth="240" SelectionChanged="DeviceChanged" />
                <TextBlock Grid.Row="0" Grid.Column="4" Text="Oversample:" Foreground="#cdcdcd" VerticalAlignment="Center" Margin="12,0,4,0" />
                <NumericUpDown x:Name="oversampleBox" Grid.Row="0" Grid.Column="5" Value="8" Minimum="1" Maximum="32" Width="80" />
                <TextBlock Grid.Row="0" Grid.Column="6" Text="Iterations:" Foreground="#cdcdcd" VerticalAlignment="Center" Margin="12,0,4,0" />
                <NumericUpDown x:Name="iterationsBox" Grid.Row="0" Grid.Column="7" Value="8" Minimum="1" Maximum="64" Width="80" />
                <Button x:Name="startStopButton" Grid.Row="0" Grid.Column="8" Content="Start" Margin="12,0,0,0" Click="StartStopClicked" MinWidth="80" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Inputs:" Foreground="#cdcdcd" VerticalAlignment="Top" Margin="0,8,6,0" />
                <ListBox x:Name="inputsList" Grid.Row="1" Grid.Column="1" Height="80" SelectionMode="Multiple" Margin="0,8,0,0" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="Outputs:" Foreground="#cdcdcd" VerticalAlignment="Top" Margin="12,8,6,0" />
                <ListBox x:Name="outputsList" Grid.Row="1" Grid.Column="3" Height="80" SelectionMode="Multiple" Margin="0,8,0,0" />
            </Grid>
        </Border>

        <!-- Scope -->
        <c:ScopeView x:Name="scope" Grid.Row="1" />

        <!-- Peak meters -->
        <Border Grid.Row="2" Background="#252526" Padding="8">
            <Grid ColumnDefinitions="Auto,*,Auto,*">
                <TextBlock Grid.Column="0" Text="In peak:" Foreground="#cdcdcd" Margin="0,0,6,0" VerticalAlignment="Center" />
                <ProgressBar x:Name="inMeter" Grid.Column="1" Minimum="0" Maximum="1" Value="0" Height="14" />
                <TextBlock Grid.Column="2" Text="Out peak:" Foreground="#cdcdcd" Margin="12,0,6,0" VerticalAlignment="Center" />
                <ProgressBar x:Name="outMeter" Grid.Column="3" Minimum="0" Maximum="1" Value="0" Height="14" />
            </Grid>
        </Border>

        <!-- Status -->
        <Border Grid.Row="3" Background="#252526" Padding="6,2">
            <TextBlock x:Name="statusText" Foreground="#cdcdcd" Text="Stopped." />
        </Border>
    </Grid>
</Window>
