<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LiveSPICE.Avalonia.Windows.AboutWindow"
        Title="About LiveSPICE"
        Width="500" Height="300"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    <Grid RowDefinitions="*,Auto" Margin="24">
        <StackPanel Grid.Row="0" Spacing="10">
            <TextBlock Text="LiveSPICE" FontSize="26" FontWeight="Bold" />
            <TextBlock Text="Real-time SPICE-like circuit simulator for guitar amps and effects."
                       TextWrapping="Wrap" Opacity="0.85" />
            <TextBlock x:Name="versionText" Opacity="0.7" />
            <TextBlock Text="http://www.livespice.org" Opacity="0.7" />
            <TextBlock Text="Avalonia UI head — cross-platform foundation."
                       FontStyle="Italic" Opacity="0.55" Margin="0,10,0,0" />
        </StackPanel>
        <Button Grid.Row="1" Content="Close" HorizontalAlignment="Right" MinWidth="90" Click="CloseClicked" Classes="accent" />
    </Grid>
</Window>
