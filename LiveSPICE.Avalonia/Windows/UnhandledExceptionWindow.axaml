<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LiveSPICE.Avalonia.Windows.UnhandledExceptionWindow"
        Title="Unhandled Error"
        Width="680" Height="500"
        WindowStartupLocation="CenterOwner">
    <Grid RowDefinitions="Auto,*,Auto" Margin="18">
        <TextBlock Grid.Row="0" Text="An unhandled error occurred." FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"
                   Foreground="{DynamicResource SystemErrorTextColor}" />
        <Border Grid.Row="1" BorderBrush="{DynamicResource SystemControlForegroundChromeMediumLowBrush}" BorderThickness="1" CornerRadius="2"
                Background="{DynamicResource SystemControlBackgroundChromeBlackHighBrush}">
            <ScrollViewer Padding="10">
                <TextBlock x:Name="detailText" FontFamily="Consolas,monospace" TextWrapping="Wrap" FontSize="12" />
            </ScrollViewer>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
            <Button Content="Copy" Click="CopyClicked" MinWidth="90" />
            <Button Content="Close" Click="CloseClicked" MinWidth="90" Classes="accent" />
        </StackPanel>
    </Grid>
</Window>
