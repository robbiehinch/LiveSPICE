<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <RootNamespace>LiveSPICE.Avalonia</RootNamespace>
    <AssemblyName>LiveSPICE.Avalonia</AssemblyName>
  </PropertyGroup>
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <DefineConstants>$(DefineConstants);LIVESPICE_WINDOWS</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <DefineConstants>$(DefineConstants);LIVESPICE_OSX</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <!--
      Versions are placeholders. The Avalonia 11.x line is the target per the plan; pin
      the exact patch once the upgrade work proper kicks off (Tier 4 in the macOS-port
      plan).
    -->
    <PackageReference Include="Avalonia" Version="11.3.15" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.15" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.15" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.15" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.15" Condition="'$(Configuration)' == 'Debug'" />
    <!-- Docking — equivalent of AvalonDock for Avalonia. Dock pins to its own
         Avalonia version, so keep the major in sync. -->
    <PackageReference Include="Dock.Avalonia" Version="11.3.0" />
    <PackageReference Include="Dock.Model.Mvvm" Version="11.3.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Audio\Audio.csproj" />
    <!-- Audio backends discovered by reflection at runtime via Audio.Driver.Drivers.
         Referenced here purely so the assemblies are loaded. -->
    <ProjectReference Include="..\WaveAudio\WaveAudio.csproj" />
    <ProjectReference Include="..\Asio\Asio.csproj" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
    <ProjectReference Include="..\Circuit\Circuit.csproj" />
    <ProjectReference Include="..\ComputerAlgebra\ComputerAlgebra\ComputerAlgebra.csproj" />
    <ProjectReference Include="..\SchematicControls.Abstractions\SchematicControls.Abstractions.csproj" />
    <ProjectReference Include="..\SchematicControls.Editor\SchematicControls.Editor.csproj" />
    <ProjectReference Include="..\Util\Util.csproj" />
    <!-- macOS-only audio backend. The reflection-based Audio.Driver.Drivers enumerator picks this up at runtime. -->
    <ProjectReference Include="..\CoreAudio\CoreAudio.csproj" Condition="$([MSBuild]::IsOSPlatform('OSX'))" />
  </ItemGroup>
</Project>
