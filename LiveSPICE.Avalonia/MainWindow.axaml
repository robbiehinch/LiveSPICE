<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:LiveSPICE.Avalonia.Controls"
        x:Class="LiveSPICE.Avalonia.MainWindow"
        Title="LiveSPICE"
        Width="1320" Height="860">
    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <Menu Grid.Row="0">
            <MenuItem Header="_File">
                <MenuItem Header="_New" InputGesture="Ctrl+N" Click="NewClicked" />
                <MenuItem Header="_Open..." InputGesture="Ctrl+O" Click="OpenClicked" />
                <MenuItem Header="_Save" InputGesture="Ctrl+S" Click="SaveClicked" />
                <MenuItem Header="Save _As..." InputGesture="Ctrl+Shift+S" Click="SaveAsClicked" />
                <Separator />
                <MenuItem Header="_Import LTSpice..." Click="ImportLtSpiceClicked" />
                <Separator />
                <MenuItem x:Name="recentMenu" Header="_Recent Files" />
                <Separator />
                <MenuItem Header="E_xit" Click="ExitClicked" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" InputGesture="Ctrl+Z" Click="UndoClicked" />
                <MenuItem Header="_Redo" InputGesture="Ctrl+Y" Click="RedoClicked" />
                <Separator />
                <MenuItem Header="_Delete" InputGesture="Delete" Click="DeleteClicked" />
                <MenuItem Header="Select _All" InputGesture="Ctrl+A" Click="SelectAllClicked" />
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="_Selection" Click="ToolSelectionClicked" />
                <MenuItem Header="_Wire" Click="ToolWireClicked" />
            </MenuItem>
            <MenuItem Header="_Simulate">
                <MenuItem Header="_Run..." InputGesture="F5" Click="SimulateClicked" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About" Click="AboutClicked" />
            </MenuItem>
        </Menu>

        <Border Grid.Row="1" Classes="statusbar">
            <TextBlock x:Name="toolStatus" Text="Tool: Selection" Opacity="0.85" />
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="300,4,*,4,320">
            <Grid Grid.Column="0" RowDefinitions="*,4,260">
                <Border Grid.Row="0" Classes="pane" Padding="0">
                    <Grid RowDefinitions="Auto,*">
                        <TextBlock Grid.Row="0" Classes="h1" Text="Components" Margin="10,10,10,6" />
                        <c:ComponentLibrary x:Name="library" Grid.Row="1" />
                    </Grid>
                </Border>
                <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" />
                <Border Grid.Row="2" Classes="pane">
                    <Grid RowDefinitions="Auto,*">
                        <TextBlock Grid.Row="0" Classes="h1" Text="Properties" />
                        <ScrollViewer Grid.Row="1">
                            <c:PropertyPane x:Name="propertyPane" />
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1" Width="4" VerticalAlignment="Stretch" />

            <c:SchematicView x:Name="schematicView" Grid.Column="2" />

            <GridSplitter Grid.Column="3" Width="4" VerticalAlignment="Stretch" />

            <Border Grid.Column="4" Classes="pane">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0" Classes="h1" Text="Log" />
                    <ScrollViewer Grid.Row="1">
                        <TextBlock x:Name="logText" TextWrapping="Wrap" FontFamily="Consolas,monospace" FontSize="12" Opacity="0.85" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Classes="statusbar">
            <TextBlock x:Name="statusText" Text="Ready" Opacity="0.85" />
        </Border>
    </Grid>
</Window>
